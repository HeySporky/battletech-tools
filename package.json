{
  "name": "battletech-tools",
  "version": "0.7.0",
  "homepage": "https://heysporky.github.io/battletech-tools",
  "private": true,
  "engines": {
    "node": "^22.22.0 || ^24.0.0 || >=26.0.0"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "fast-xml-parser": "^5.11.1",
    "react": "^19.3.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.0",
    "react-icons": "^5.7.0",
    "react-router": "^8.4.0",
    "sanitize-html": "^2.17.7"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "dev:host": "vite --host",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "node scripts/typecheck.mjs",
    "typecheck:ts6": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:browser": "vitest run --project browser",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run build",
    "mul:sync": "node tools/mul-sync/sync-mul.mjs",
    "deploy-dev": "gh-pages -d build --dotfiles",
    "deploy-prod": "gh-pages -d build --dotfiles -r https://github.com/heysporky/battletech-tools.git"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.5",
    "playwright": "^1.63.0",
    "sass": "^1.105.0",
    "typescript": "~6.0.3",
    "typescript-7": "npm:typescript@^7.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "@parcel/watcher": false
  }
}
