# ---------------------------------------------------------------------------
# Dependencies
# ---------------------------------------------------------------------------
node_modules/
npm-debug.log*
yarn-error.log*
.eslintcache


# ---------------------------------------------------------------------------
# Build output
# ---------------------------------------------------------------------------
build/
dist/
dist-ssr/
coverage/
*.tsbuildinfo

# node_modules/.vite is already covered; this catches caches outside it.
.vite/

# Nested project copy that the build/deploy tooling keeps recreating.
/battletech-tools/

# ---------------------------------------------------------------------------
# Local scratch directories (root-anchored so they cannot swallow source files
# such as .github/workflows or src/work*.ts)
# ---------------------------------------------------------------------------
/old*
/work*
/boneyard*
/cli-tools/
/SSW-Master/
/SSW-Equipment/
tools/.live-mul-battle-armor/

# ---------------------------------------------------------------------------
# Python helper tooling byproducts
# ---------------------------------------------------------------------------
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# Scratch and backup artifacts
# ---------------------------------------------------------------------------
*.bak
*.tmp

# ---------------------------------------------------------------------------
# Editor / OS / miscellaneous local files
# ---------------------------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
.gitlab-ci.yml
.htaccess
robots.txt

# Local environment files; keep shareable .env.example files trackable.
.env
.env.*
!.env.example

# Local development workspaces are never part of the synchronized source.
*_DEV/

# ---------------------------------------------------------------------------
# Ollama AI engine rules and helpers (root-anchored; the committed equivalents
# under tools/ are intentional project tooling and must stay tracked)
# ---------------------------------------------------------------------------
/.clinerules
/as_lookup_results.jsonl
/batch_as_lookup.py
/ollama*
/cline_custom_modes.json

# GitHub Actions workflows are required; guard against the broad patterns above.
!.github/
!.github/workflows/
!.github/workflows/*.yml

# Browser state for the MUL sync tool (includes cookies and other session data)
tools/mul-sync/browser-state.json
